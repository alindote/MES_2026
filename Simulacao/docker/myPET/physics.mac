#
#       P H Y S I C S
#
/gate/physics/addProcess PhotoElectric
/gate/physics/processes/PhotoElectric/setModel StandardModel

/gate/physics/addProcess Compton
/gate/physics/processes/Compton/setModel StandardModel

/gate/physics/addProcess RayleighScattering 
/gate/physics/processes/RayleighScattering/setModel LivermoreModel

/gate/physics/addProcess ElectronIonisation
/gate/physics/processes/ElectronIonisation/setModel StandardModel e-
/gate/physics/processes/ElectronIonisation/setModel StandardModel e+

/gate/physics/addProcess Bremsstrahlung
/gate/physics/processes/Bremsstrahlung/setModel StandardModel e-
/gate/physics/processes/Bremsstrahlung/setModel StandardModel e+

/gate/physics/addProcess PositronAnnihilation

/gate/physics/addProcess eMultipleScattering
/gate/physics/processes/eMultipleScattering/setGeometricalStepLimiterType e- distanceToBoundary
/gate/physics/processes/eMultipleScattering/setGeometricalStepLimiterType e+ distanceToBoundary

/gate/physics/addProcess RadioactiveDecay

/gate/physics/addAtomDeexcitation
#/process/em/fluo  false
#/process/em/auger false
#/process/em/pixe  false

/gate/physics/processList Enabled
/gate/physics/processList Initialized

#
#       C U T S
#

# Cuts for particles in the world
/gate/physics/Gamma/SetCutInRegion      world 1.0 cm
/gate/physics/Electron/SetCutInRegion   world 1.0 cm
/gate/physics/Positron/SetCutInRegion   world 1.0 cm

# Cuts for particle in cylindricalPET
#/gate/physics/Gamma/SetCutInRegion      cylindricalPET 0.5 cm
#/gate/physics/Electron/SetCutInRegion   cylindricalPET 0.5 cm
#/gate/physics/Positron/SetCutInRegion   cylindricalPET 0.5 cm

# We could have different cuts for particle in the crystals
#/gate/physics/Gamma/SetCutInRegion      crystal 1.0 mm
#/gate/physics/Electron/SetCutInRegion   crystal 1.0 mm
#/gate/physics/Positron/SetCutInRegion   crystal 1.0 mm

# And also in the phantom
#/gate/physics/Gamma/SetCutInRegion      my_phantom 1.0 cm
#/gate/physics/Electron/SetCutInRegion   my_phantom 1.0 cm
#/gate/physics/Positron/SetCutInRegion   my_phantom 1.0 cm
